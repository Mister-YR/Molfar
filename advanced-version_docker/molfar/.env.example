# Скопіюйте у .env і змініть під себе:  cp .env.example .env

# Доступ до веб-інтерфейсу (порожній пароль = без авторизації).
# Пароль, змінений у веб-інтерфейсі, має пріоритет; скинути: docker compose exec molfar molfar-reset-password
MOLFAR_USER=admin
MOLFAR_PASSWORD=Molfar

# Порт веб-інтерфейсу на хості (мережа хоста — порт відкривається одразу на ВМ)
MOLFAR_PORT=8080
# Адреса прослуховування: 0.0.0.0 — усі інтерфейси; напр. 192.168.1.50 — лише LAN
MOLFAR_HOST=0.0.0.0

# Часовий пояс — за ним іде розклад нічного speedtest
TZ=Europe/Kyiv

# Рівень журналу: DEBUG | INFO | WARNING
MOLFAR_LOG=INFO

# 1 — піднімати профілі WireGuard з «автозапуском» при старті контейнера; 0 — ні
MOLFAR_WG_AUTOSTART=1

# 1 — при старті перевіряти пересилання IPv4 (доступ з VPN до LAN через Мольфар) і підказувати, що
# налаштувати на хості; 0 — не перевіряти (Мольфар не має бути маршрутизатором)
MOLFAR_IP_FORWARD=1

# Збірка: 0 — без додаткових мережевих утиліт (mtr, tcpdump, iftop, …); traceroute, nslookup, telnet і iperf3 є завжди
EXTRA_TOOLS=1

# Назва образу (напр. ваш реєстр після docker/build-multiarch.sh): registry.example.com/molfar:latest
MOLFAR_IMAGE=molfar:latest
