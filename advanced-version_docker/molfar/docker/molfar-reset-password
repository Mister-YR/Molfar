#!/bin/sh
# Скидає пароль, змінений у веб-інтерфейсі, на MOLFAR_PASSWORD із .env (за замовчуванням Molfar).
#   docker compose exec molfar molfar-reset-password && docker compose restart molfar
set -e
cd /opt/molfar
/opt/molfar/venv/bin/python -m molfar reset-password >/dev/null
echo "Molfar: пароль скинуто на MOLFAR_PASSWORD із .env. Перезапустіть:  docker compose restart molfar"
