#!/bin/sh
# Заглушка resolvconf для контейнера Мольфара.
# wg-quick викликає `resolvconf -a/-d`, якщо в профілі є рядок «DNS = …». У контейнері DNS
# належить Docker/хосту, тож рядок DNS ігнорується (тунель усе одно піднімається).
# Для повного тунелю (0.0.0.0/0) DNS-запити й так ідуть через тунель.
case "$1" in
  -a) cat >/dev/null; echo "molfar: DNS із профілю $2 у контейнері не застосовується (використовується DNS хоста)" >&2 ;;
  -l) ;;
esac
exit 0
